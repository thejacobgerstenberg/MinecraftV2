    "interact":     { "primary": "Mouse2",    "secondary": "KeyF",       "gamepad": 2 },
    "eat":          { "primary": "Mouse2",    "secondary": null,         "gamepad": 6 },
    "hotbar1":      { "primary": "Digit1",    "secondary": null,         "gamepad": null },
