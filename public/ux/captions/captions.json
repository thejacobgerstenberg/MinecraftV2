    { "sound": "splash", "text": "Water splashes", "category": "ambient", "priority": 3, "durationMs": 2000, "directional": true },
    { "sound": "wind", "text": "Wind whistles", "category": "ambient", "priority": 1, "durationMs": 4000 },
    { "sound": "cave", "text": "Cave drone, water drips", "category": "ambient", "priority": 1, "durationMs": 4000 },
