    { "sound": "boss.*.defeated", "text": "{mob} falls, defeated", "category": "alert", "priority": 8, "durationMs": 4000 },
    { "sound": "boss.molthkin.telegraph", "text": "Molthkin winds up to strike!", "category": "alert", "priority": 9, "durationMs": 3000, "directional": true },
    { "sound": "boss.molthkin.defeated", "text": "Molthkin unspools, defeated", "category": "alert", "priority": 8, "durationMs": 4000 },
    { "sound": "boss.lastneedle.telegraph", "text": "The Last Needle draws back!", "category": "alert", "priority": 9, "durationMs": 3000, "directional": true },
    { "sound": "boss.lastneedle.defeated", "text": "The Last Needle is bound", "category": "alert", "priority": 8, "durationMs": 4000 }
