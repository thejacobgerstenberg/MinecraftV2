{
  "$schema": "../schemas/captions.schema.json",
  "version": 1,
  "captions": [
    { "sound": "break.*", "text": "{material} breaks", "category": "action", "priority": 3, "durationMs": 2000, "directional": true },
    { "sound": "place.*", "text": "{material} placed", "category": "action", "priority": 3, "durationMs": 2000, "directional": true },
    { "sound": "step.*", "text": "Footsteps on {material}", "category": "action", "priority": 2, "durationMs": 1500, "directional": true },
    { "sound": "break.glass", "text": "Glass shatters", "category": "action", "priority": 4, "durationMs": 2000, "directional": true },

    { "sound": "mob.*.idle", "text": "{mob} calls nearby", "category": "mob", "priority": 5, "durationMs": 3000, "directional": true },
    { "sound": "mob.*.hurt", "text": "{mob} is hurt", "category": "mob", "priority": 6, "durationMs": 2500, "directional": true },
    { "sound": "mob.*.death", "text": "{mob} dies", "category": "mob", "priority": 6, "durationMs": 3000, "directional": true },
    { "sound": "mob.grazer.idle", "text": "Grazer bleats softly", "category": "mob", "priority": 4, "durationMs": 3000, "directional": true },
