    { "sound": "ui.click", "text": "Click", "category": "action", "priority": 3, "durationMs": 1000 },
    { "sound": "hurt", "text": "You are hurt!", "category": "alert", "priority": 10, "durationMs": 2500 },
    { "sound": "pop", "text": "Item picked up", "category": "action", "priority": 3, "durationMs": 1500 },

    { "sound": "door.open", "text": "Door creaks open", "category": "action", "priority": 4, "durationMs": 2000, "directional": true },
    { "sound": "door.close", "text": "Door shuts", "category": "action", "priority": 4, "durationMs": 2000, "directional": true },
    { "sound": "chest.open", "text": "Chest opens", "category": "action", "priority": 4, "durationMs": 2000 },
    { "sound": "eat", "text": "Eating", "category": "action", "priority": 3, "durationMs": 2000 },
    { "sound": "drink", "text": "Drinking", "category": "action", "priority": 3, "durationMs": 2000 },
    { "sound": "levelup", "text": "Bright chime rings", "category": "action", "priority": 6, "durationMs": 3000 },
    { "sound": "achievement", "text": "Achievement chime", "category": "action", "priority": 6, "durationMs": 3000 },
    { "sound": "explosion", "text": "Explosion!", "category": "alert", "priority": 10, "durationMs": 4000, "directional": true },

