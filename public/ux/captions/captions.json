    { "sound": "music.calm", "text": "♪ Calm weaving music", "category": "music", "priority": 1, "durationMs": 5000 },
    { "sound": "music.nether", "text": "♪ Smoldering furnace music", "category": "music", "priority": 1, "durationMs": 5000 },
    { "sound": "music.upbeat", "text": "♪ Upbeat spindle-reel", "category": "music", "priority": 1, "durationMs": 5000 },
    { "sound": "music.melancholy", "text": "♪ Melancholy thread-song", "category": "music", "priority": 1, "durationMs": 5000 },
    { "sound": "music.mysterious", "text": "♪ Eerie Nevermend music", "category": "music", "priority": 1, "durationMs": 5000 },

