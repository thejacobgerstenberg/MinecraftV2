# deploy/.env.example — copy to deploy/.env and edit for your deployment.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/run loads deploy/.env if present, then launches `node server/index.js`
# from the repo root. Blank lines and lines starting with `#` are ignored.
#
# Legend:
#   [ACTIVE]  — read by the server today (verified in server/index.js).
#   [PLANNED] — NOT read by the server yet. deploy/run still exports it so it
#               works the instant the builder wires it in, but setting it has
#               no effect until then. Do not assume it is honored.

# -----------------------------------------------------------------------------
# [ACTIVE] PORT
# TCP port the HTTP + WebSocket server binds to.
# Read at server/index.js:25 -> `const PORT = process.env.PORT || 3000`.
# Serves the client (public/), REST (/api/*), and the WS upgrade at /ws.
PORT=3000

# -----------------------------------------------------------------------------
# [PLANNED] MAX_PLAYERS
# Intended: cap concurrent connected players. NOT read today — the server keeps
# rooms/clients unbounded by env. No effect until the builder adds support.
# MAX_PLAYERS=20

# -----------------------------------------------------------------------------
# [PLANNED] TICK_RATE
# Intended: server simulation/heartbeat rate. NOT read today — the related value
# is hardcoded (HEARTBEAT_MS = 30000 at server/index.js:34). No effect yet.
# TICK_RATE=20

# -----------------------------------------------------------------------------
# [PLANNED] WORLD_DIR
# Intended: directory where worlds/saves are persisted (for a volume mount).
# NOT read today — the saves path is hardcoded at server/index.js:24:
#   const SAVES_DIR = path.join(__dirname, '..', 'saves')
# i.e. it always resolves to <repo>/saves. No effect until the builder makes
# SAVES_DIR env-configurable. Set this now if you want it ready for that change.
# WORLD_DIR=/data/worlds

# -----------------------------------------------------------------------------
# [PLANNED] MOTD
# Intended: message-of-the-day shown to clients. NOT read today. No effect yet.
# MOTD=Welcome to loomfall

# =============================================================================
# For the builder
# -----------------------------------------------------------------------------
# The following are exported by deploy/run but the server does not read them.
# To activate each, read the suggested process.env name in server/index.js:
#
#   MAX_PLAYERS -> process.env.MAX_PLAYERS   (enforce a connection/player cap)
#   TICK_RATE   -> process.env.TICK_RATE     (drive tick/heartbeat timing;
#                                             currently HEARTBEAT_MS is hardcoded)
#   WORLD_DIR   -> process.env.WORLD_DIR      e.g.
#                    const SAVES_DIR = process.env.WORLD_DIR
#                      || path.join(__dirname, '..', 'saves');
#   MOTD        -> process.env.MOTD          (surface in the welcome frame / a
#                                             new REST field)
#
# Only PORT (process.env.PORT) is wired today. Add the above to make the
# corresponding vars in this file take effect.
# =============================================================================
